# Copy to router-reboot.env, fill in, then run: chmod 600 router-reboot.env

# Your router's LAN address, without http:// (required).
# Often printed on the router label. Example value below, replace it.
ROUTER_IP="192.168.0.2"

ROUTER_USER="admin"

# Single quotes protect passwords that contain $, quotes, or backticks.
ROUTER_PASS='change-me'
